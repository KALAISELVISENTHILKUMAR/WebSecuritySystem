{
  "manifest_version": 3,
  "name": "NEXAF Security Engine",
  "version": "2.0",
  "description": "Next-Generation Explainable AI Firewall browser enforcement layer.",
  "permissions": ["webNavigation", "storage", "notifications", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}